        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(topk(10, sum by (image_repository, image_tag) (max by (image_repository, image_tag, severity) (trivy_image_vulnerabilities{severity=~\"Critical|High\"})) > 0))",
          "refId": "A",
