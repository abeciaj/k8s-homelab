    {
      "id": 10,
      "type": "bargauge",
      "title": "Most vulnerable images",
      "description": "Top 10 images by fixable high and critical vulnerabilities. Updating these clears the most findings.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
