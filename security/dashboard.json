    {
      "id": 12,
      "type": "table",
      "title": "Issues",
      "description": "Every fixable high and critical vulnerability, one row per image. Click a CVE to open it in NVD; filter any column from its header.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (vuln_id, severity, vuln_score, image_repository, image_tag, resource, installed_version, fixed_version, vuln_title) (trivy_vulnerability_id)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "vuln_id": 0,
              "severity": 1,
              "vuln_score": 2,
              "image_repository": 3,
              "image_tag": 4,
              "resource": 5,
              "installed_version": 6,
              "fixed_version": 7,
              "vuln_title": 8
            },
            "renameByName": {
              "vuln_id": "CVE",
              "severity": "Severity",
              "vuln_score": "Score",
              "image_repository": "Image",
              "image_tag": "Tag",
              "resource": "Package",
              "installed_version": "Installed",
              "fixed_version": "Fixed in",
              "vuln_title": "Title"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Score",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in NVD",
                    "targetBlank": true,
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Score"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fixed in"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Score"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Image"
